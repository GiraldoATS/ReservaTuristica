<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-FondoXYZ.Web-0265650e-d2d4-4cc5-8773-220a480c29ac</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.27" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.27">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Web es el composition root: conoce Infrastructure solo para registrar sus adaptadores. -->
    <ProjectReference Include="..\FondoXYZ.Application\FondoXYZ.Application.csproj" />
    <ProjectReference Include="..\FondoXYZ.Infrastructure\FondoXYZ.Infrastructure.csproj" />
  </ItemGroup>

</Project>
