@{
    // El nombre viaja como claim en la cookie (ver ApplicationUserClaimsPrincipalFactory),
    // así no se consulta la base de datos en cada request.
    var nombre = User.FindFirst(ClaimsPersonalizados.NombreCompleto)?.Value ?? User.Identity?.Name;
}

<ul class="navbar-nav">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">

            <span class="nav-link text-dark fw-semibold">

                Hola
                @nombre

            </span>

        </li>

        <li class="nav-item">

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                <button type="submit"
                        class="nav-link btn btn-link text-danger border-0">

                    Cerrar sesión

                </button>

            </form>

        </li>
    }
    else
    {
        <li class="nav-item">

            <a class="nav-link text-primary"
               asp-controller="Account"
               asp-action="Login">

                Iniciar sesión

            </a>

        </li>
    }

</ul>
