@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="alert alert-danger mt-4">
    <h4>Ocurrió un error inesperado</h4>
    <p class="mb-0">Intenta nuevamente. Si el problema persiste, contacta al administrador.</p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-2 mb-0 small text-muted">Código de seguimiento: <code>@Model.RequestId</code></p>
    }
</div>
