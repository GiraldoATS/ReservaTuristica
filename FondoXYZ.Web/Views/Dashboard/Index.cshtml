@model DashboardDto

<h2 class="mb-4">
    Dashboard
</h2>

<div class="row">

    <div class="col-md-3 mb-3">

        <div class="card shadow-sm">

            <div class="card-body">

                <h6 class="text-muted">
                    Total Reservas
                </h6>

                <h3>
                    @Model.TotalReservas
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-3">

        <div class="card shadow-sm">

            <div class="card-body">

                <h6 class="text-muted">
                    Ingresos Totales
                </h6>

                <h3>
                    @Model.IngresosTotales.ToString("C")
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-3">

        <div class="card shadow-sm">

            <div class="card-body">

                <h6 class="text-muted">
                    Alojamientos
                </h6>

                <h3>
                    @Model.TotalAlojamientos
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-3">

        <div class="card shadow-sm">

            <div class="card-body">

                <h6 class="text-muted">
                    Tarifas Activas
                </h6>

                <h3>
                    @Model.TarifasActivas
                </h3>

            </div>

        </div>

    </div>

</div>

<div class="card shadow-sm mt-4">

    <div class="card-body">

        <h5 class="mb-3">
            Últimas Reservas
        </h5>

        <table class="table table-hover">

            <thead>

                <tr>

                    <th>Id</th>

                    <th>Alojamiento</th>

                    <th>Fecha Inicio</th>

                    <th>Fecha Fin</th>

                    <th>Total</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.UltimasReservas)
                {
                    <tr>

                        <td>
                            @item.IdReserva
                        </td>

                        <td>
                            @item.Alojamiento
                        </td>

                        <td>
                            @item.FechaInicio.ToShortDateString()
                        </td>

                        <td>
                            @item.FechaFin.ToShortDateString()
                        </td>

                        <td>
                            @item.Total.ToString("C")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>