@model List<FondoXYZ.Entities.Reserva>

<h2>Reservas</h2>

<a asp-action="Create"
   class="btn btn-primary mb-3">
    Nueva Reserva
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Personas</th>
            <th>Total</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdReserva</td>
                <td>@item.FechaInicio</td>
                <td>@item.FechaFin</td>
                <td>@item.NumeroPersonas</td>
                <td>@item.Total</td>
            </tr>
        }

    </tbody>
</table>