@model FondoXYZ.Entities.ViewModels.ReservaCreateViewModel

<h2 class="mb-4">
    Nueva Reserva
</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary()
    </div>
}

<form asp-controller="Reservas"
      asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <!-- ID ALOJAMIENTO -->
    <input type="hidden"
           asp-for="IdAlojamiento" />

    <!-- TOTAL -->
    <input type="hidden"
           asp-for="Total" />

    <div class="card shadow-sm">

        <div class="card-body">

            <!-- ALOJAMIENTO -->

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Alojamiento Seleccionado
                </label>

                <input value="@Model.NombreAlojamiento"
                       class="form-control bg-light"
                       readonly />

            </div>

            <!-- FECHAS -->

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">
                        Fecha Inicio
                    </label>

                    <input asp-for="FechaInicio"
                           type="date"
                           class="form-control"
                           id="fechaInicio" />

                    <span asp-validation-for="FechaInicio"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">
                        Fecha Fin
                    </label>

                    <input asp-for="FechaFin"
                           type="date"
                           class="form-control"
                           id="fechaFin" />

                    <span asp-validation-for="FechaFin"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <!-- PERSONAS -->

            <div class="mb-3">

                <label class="form-label fw-bold">
                    Número Personas
                </label>

                <input asp-for="NumeroPersonas"
                       type="number"
                       class="form-control"
                       id="numeroPersonas" />

                <small class="text-muted">
                    Capacidad máxima:
                    @Model.CapacidadMaxima personas
                </small>

                <span asp-validation-for="NumeroPersonas"
                      class="text-danger">
                </span>

            </div>

            <!-- TOTAL -->

            <div class="mb-4">

                <label class="form-label fw-bold">
                    Total
                </label>

                <input id="totalVisual"
                       class="form-control bg-light"
                       readonly />

            </div>

            <!-- BOTON -->

            <button type="submit"
                    class="btn btn-success w-100"
                    id="btnGuardar">

                Guardar Reserva

            </button>

        </div>

    </div>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        async function calcularTarifa() {

            const idAlojamiento =
                document.querySelector(
                    '[name="IdAlojamiento"]'
                ).value;

            const fechaInicio =
                document.getElementById(
                    "fechaInicio"
                ).value;

            const fechaFin =
                document.getElementById(
                    "fechaFin"
                ).value;

            const numeroPersonas =
                document.getElementById(
                    "numeroPersonas"
                ).value;

            if (
                !fechaInicio ||
                !fechaFin ||
                !numeroPersonas
            ) {
                return;
            }

            try {

                console.log("CALCULANDO TARIFA...");

                const response =
                    await fetch(
                        '/Reservas/CalcularTarifa',
                        {
                            method: 'POST',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body: JSON.stringify({

                                idAlojamiento:
                                    parseInt(
                                        idAlojamiento
                                    ),

                                numeroPersonas:
                                    parseInt(
                                        numeroPersonas
                                    ),

                                fechaInicio:
                                    fechaInicio,

                                fechaFin:
                                    fechaFin
                            })
                        });

                const data =
                    await response.json();

                console.log(
                    "RESPUESTA TARIFA:",
                    data
                );

                if (data.error) {

                    alert(data.error);

                    return;
                }

                // INPUT OCULTO
                document.querySelector(
                    '[name="Total"]'
                ).value =
                    data.totalPagar;

                // INPUT VISUAL
                document.getElementById(
                    "totalVisual"
                ).value =
                    "$ " +
                    parseFloat(
                        data.totalPagar
                    ).toLocaleString(
                        'es-CO'
                    );

            }
            catch (error) {

                console.log(error);

                alert(
                    "Error calculando tarifa"
                );
            }
        }

        // EVENTOS

        document
            .getElementById("fechaInicio")
            .addEventListener(
                "change",
                calcularTarifa
            );

        document
            .getElementById("fechaFin")
            .addEventListener(
                "change",
                calcularTarifa
            );

        document
            .getElementById("numeroPersonas")
            .addEventListener(
                "input",
                calcularTarifa
            );

        calcularTarifa();

    </script>
}