@model FondoXYZ.Entities.Reserva

<h2>Nueva Reserva</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label>Id Alojamiento</label>

        <input asp-for="IdAlojamiento"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Fecha Inicio</label>

        <input asp-for="FechaInicio"
               type="date"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Fecha Fin</label>

        <input asp-for="FechaFin"
               type="date"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Número Personas</label>

        <input asp-for="NumeroPersonas"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Total</label>

        <input asp-for="Total"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Guardar
    </button>

</form>