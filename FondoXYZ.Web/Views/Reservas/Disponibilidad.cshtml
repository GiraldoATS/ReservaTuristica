@model List<FondoXYZ.Entities.DTOs.DisponibilidadDto>

<h2>Consultar Disponibilidad</h2>

<form method="post">

    <div class="row">

        <div class="col-md-4">
            <label>Fecha Inicio</label>

            <input type="date"
                   name="fechaInicio"
                   class="form-control" />
        </div>

        <div class="col-md-4">
            <label>Fecha Fin</label>

            <input type="date"
                   name="fechaFin"
                   class="form-control" />
        </div>

        <div class="col-md-4 mt-4">
            <button class="btn btn-primary">
                Consultar
            </button>
        </div>

    </div>

</form>

<hr />

@if (Model != null)
{
    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Sede</th>
                <th>Alojamiento</th>
                <th>Capacidad</th>
                <th>Tipo</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Sede</td>
                    <td>@item.Alojamiento</td>
                    <td>@item.CapacidadMaxima</td>
                    <td>@item.Tipo</td>
                </tr>
            }

        </tbody>

    </table>
}