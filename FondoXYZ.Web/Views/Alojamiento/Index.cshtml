@model IReadOnlyList<AlojamientoDto>

<h2>Alojamientos</h2>

<partial name="_Alertas" />

<a asp-action="Create"
   class="btn btn-primary mb-3">
    Nuevo
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Sede</th>
            <th>Capacidad</th>
            <th>Habitaciones</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Tipo</td>
                <td>@item.Sede</td>
                <td>@item.CapacidadMaxima</td>
                <td>@item.CantidadHabitaciones</td>
                <td>
                    @(item.Activo ? "Activo" : "Inactivo")
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.IdAlojamiento"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@item.IdAlojamiento"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('¿Eliminar este alojamiento?');">
                        <button type="submit"
                                class="btn btn-danger">
                            Eliminar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>