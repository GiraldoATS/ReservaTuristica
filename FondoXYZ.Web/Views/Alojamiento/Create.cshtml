@model FondoXYZ.Entities.Alojamiento

<h2>Nuevo Alojamiento</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label>Nombre</label>

        <input asp-for="Nombre"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Tipo</label>

        <input asp-for="Tipo"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Sede</label>

        <select asp-for="IdSede"
                asp-items="ViewBag.Sedes"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label>Capacidad Máxima</label>

        <input asp-for="CapacidadMaxima"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Cantidad Habitaciones</label>

        <input asp-for="CantidadHabitaciones"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Descripción</label>

        <textarea asp-for="Descripcion"
                  class="form-control">
        </textarea>
    </div>

    <button type="submit"
            class="btn btn-success">
        Guardar
    </button>

</form>