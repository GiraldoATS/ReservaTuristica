@model IReadOnlyList<SedeDto>

<h2>Sedes</h2>

<partial name="_Alertas" />

<a asp-action="Create"
   class="btn btn-primary mb-3">
    Nueva Sede
</a>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdSede</td>
                <td>@item.Nombre</td>
            </tr>
        }

    </tbody>

</table>